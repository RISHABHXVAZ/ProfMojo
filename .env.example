# ==============================================================================
# ProfMojo Local Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in the required environment variables below before running docker compose.
# 3. .env is gitignored and must never be committed to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://postgres:5432/profmojo
DB_USERNAME=profmojo
DB_PASSWORD=profmojo

# JWT Secret for Signing Authentication Tokens (Minimum 256 bits for HMAC-SHA256)
# REQUIRED: Must be set. Container startup will fail if JWT_SECRET is unset or empty.
JWT_SECRET=your_jwt_signing_secret_min_32_characters

# Department Seed for Initial Admin Login (Department:Email:SecretKey)
# Format: <DEPARTMENT>:<ADMIN_EMAIL>:<SECRET_KEY>
ADMIN_DEPARTMENT_SEEDS=CSE:admin@example.com:19472026

# Spring Mail / SMTP Configuration for OTP Delivery
# Set your SMTP credentials for real email delivery (e.g. Gmail App Password)
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Redis In-Memory Datastore Configuration
# REQUIRED: Must be set. Docker startup will fail if REDIS_PASSWORD is unset or empty.
REDIS_PASSWORD=change_this_to_a_secure_redis_password

# Trusted Proxy Configuration
# Set to 'true' only when running behind a trusted reverse proxy (e.g. Nginx, ALB)
# When 'false' (default), rate limiter relies strictly on TCP remote address to prevent header spoofing.
TRUST_PROXY_HEADERS=false
