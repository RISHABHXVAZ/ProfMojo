# ==============================================================================
# ProfMojo Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in required values.
# 3. .env is gitignored and must NEVER be committed to source control.
# 4. In PRODUCTION, supply all secrets via secure secret manager or CI/CD environment.
#    DO NOT use development default passwords or placeholder secrets in production.
# ==============================================================================

# ===============================
# Database Configuration (PostgreSQL)
# ===============================
# LOCAL DEV DEFAULT: DB_PASSWORD=profmojo (Change in production!)
DB_NAME=profmojo
DB_USERNAME=profmojo
DB_PASSWORD=change_this_to_a_secure_postgres_password_in_production
DB_URL=jdbc:postgresql://postgres:5432/profmojo

# ===============================
# JWT Authentication Configuration
# ===============================
# REQUIRED: Cryptographically secure secret key (min 256 bits / 32 characters)
# Container startup validates key length and rejects missing/empty keys.
JWT_SECRET=change_this_to_a_random_32_character_minimum_secret_key!

# ===============================
# Redis In-Memory Datastore Configuration
# ===============================
# REQUIRED: Redis authentication password. Container startup will fail if unset.
# Docker Compose configures AOF persistence (--appendonly yes) to volume redis_data.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_secure_redis_password_in_production

# ===============================
# Initial Admin Department Seeding
# ===============================
# Format: <DEPARTMENT>:<ADMIN_EMAIL>:<SECRET_KEY>
# Example: CSE:admin@example.com:secure_random_key_here
ADMIN_DEPARTMENT_SEEDS=

# ===============================
# Spring Mail / SMTP Configuration
# ===============================
# Optional for local mock/dev; required for real email OTP delivery
MAIL_USERNAME=
MAIL_PASSWORD=

# ===============================
# Frontend & Networking
# ===============================
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api

# ===============================
# Trusted Proxy Configuration
# ===============================
# Set to 'true' ONLY when running behind a trusted reverse proxy (e.g. ALB, Cloudflare)
# that strips untrusted client-supplied headers. When 'false' (default), rate limiter
# strictly uses the TCP remote socket address to prevent IP spoofing.
TRUST_PROXY_HEADERS=false
